[Version]
Signature   = "$Windows NT$"
Class       = WFPCALLOUTS
ClassGuid   = {57465043-616C-6C6F-7574-5F636C617373}
Provider    = %ProviderString%
CatalogFile = ProxiFyre.Wfp.cat
DriverVer   = 09/18/2026,1.0.0.0
PnpLockdown = 1

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
ProxiFyre.Wfp.sys = 1,,

[DestinationDirs]
ProxiFyre.Wfp.DriverFiles = 12

[DefaultInstall.NTamd64]
OptionDesc = %ServiceDesc%
CopyFiles  = ProxiFyre.Wfp.DriverFiles

[DefaultInstall.NTamd64.Services]
AddService = %ServiceName%,,ProxiFyre.Wfp.Service

[ProxiFyre.Wfp.DriverFiles]
ProxiFyre.Wfp.sys,,,0x00000040

[ProxiFyre.Wfp.Service]
DisplayName   = %ServiceName%
Description   = %ServiceDesc%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %12%\ProxiFyre.Wfp.sys

[Strings]
ProviderString = "ProxiFyre"
DiskName       = "ProxiFyre WFP Classifier"
ServiceName    = "ProxiFyreWfp"
ServiceDesc    = "ProxiFyre WFP application flow classifier"

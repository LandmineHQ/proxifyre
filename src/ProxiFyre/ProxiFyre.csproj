<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <StartupObject>ProxiFyre.Program</StartupObject>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == 'win-x64'">x64</PlatformTarget>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == 'win-x86'">x86</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ProxiFyre</AssemblyName>
    <RootNamespace>ProxiFyre</RootNamespace>
    <AssemblyTitle>ProxiFyre</AssemblyTitle>
    <Description>WinDivert TCP and UDP relay for selected Windows applications.</Description>
    <Company>NT KERNEL</Company>
    <Product>ProxiFyre</Product>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove='System.Drawing' />
    <Using Remove='System.Windows.Forms' />
    <None Remove="Assets\AppIcon.ico" />
    <Resource Include="Assets\AppIcon.ico" />
    <Compile Include="..\Shared\LicenseKey.cs" Link="Shared\LicenseKey.cs" />
    <Compile Include="..\Shared\ModuleMessageProtocol.cs" Link="Shared\ModuleMessageProtocol.cs" />
    <Compile Include="..\Shared\TrafficTelemetry.cs" Link="Shared\TrafficTelemetry.cs" />
    <Content Include="..\..\manifest.json" Link="manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Shared\UuPatchProfiles.json" Link="UuPatchProfiles.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\licenses\WinDivert-LICENSE.txt" Link="WinDivert-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Native.WinDivert" Version="2.2.2" GeneratePathProperty="true" />
  </ItemGroup>
  <Target Name="CopyNativeAotModule" AfterTargets="Build">
    <PropertyGroup>
      <NativeAotModulePath>$(ArtifactsPath)\native\$(Configuration)\ProxiFyre.Module.dll</NativeAotModulePath>
    </PropertyGroup>
    <Copy SourceFiles="$(NativeAotModulePath)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(NativeAotModulePath)')" />
  </Target>
</Project>


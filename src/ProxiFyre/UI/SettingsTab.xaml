<UserControl x:Class="ProxiFyre.SettingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#667085" />
        <SolidColorBrush x:Key="BorderBrush" Color="#D8DEE8" />

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="ToggleSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track"
                                Background="#D0D5DD"
                                CornerRadius="12">
                            <Ellipse x:Name="Thumb"
                                     Width="18"
                                     Height="18"
                                     Margin="3"
                                     HorizontalAlignment="Left"
                                     Fill="#FFFFFF" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#2563EB" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="WinpkFilter" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="{Binding WinpkFilterDetailText}"
                           Foreground="{StaticResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="14,0,0,0">
                <Border Padding="9,4"
                        CornerRadius="12"
                        Background="{Binding WinpkFilterBadgeBackground}"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0">
                    <TextBlock Text="{Binding WinpkFilterStatusText}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{Binding WinpkFilterStatusForeground}" />
                </Border>
                <Button Content="{Binding WinpkFilterActionText}"
                        IsEnabled="{Binding IsWinpkFilterActionEnabled}"
                        Click="WinpkFilterActionButton_Click"
                        MinWidth="76"
                        Background="{Binding WinpkFilterActionBackground}"
                        Foreground="{Binding WinpkFilterActionForeground}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="UU 白名单解除"
                           FontSize="15"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding UuPatchStatusText}"
                           FontWeight="SemiBold"
                           Foreground="{Binding UuPatchStatusForeground}"
                           Margin="0,4,0,0" />
                <TextBlock Text="{Binding UuPatchDetailText}"
                           Foreground="{StaticResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Top"
                        Margin="14,0,0,0">
                <Border Padding="9,4"
                        CornerRadius="12"
                        Background="{Binding UuPatchBadgeBackground}"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0">
                    <TextBlock Text="{Binding UuPatchStatusText}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{Binding UuPatchStatusForeground}" />
                </Border>
                <ToggleButton x:Name="UuPatchToggleButton"
                              Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding IsUuPatchEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEnabled="{Binding IsUuPatchActionEnabled}"
                              Click="UuPatchToggleButton_Click"
                              ToolTip="在 UU 进程中应用或恢复 local_proxy.dll 运行时补丁" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
